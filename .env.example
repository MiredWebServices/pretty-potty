# =============================================================================
# Frontend (Vite) environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# =============================================================================

# Supabase project URL — Dashboard → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://whvuohkpbcpytmwnhriy.supabase.co

# Supabase anon (publishable) key — Dashboard → Project Settings → API → "anon public"
# Safe to ship to the browser. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...replace-me...
