# =============================================================================
# Supabase Edge Functions — environment variables (a.k.a. "Function Secrets")
#
# These are NOT loaded by Vite. Set them in:
#   Supabase Dashboard → Project Settings → Edge Functions → Secrets
# OR via CLI:
#   supabase secrets set --env-file ./supabase/functions/.env
#
# Copy this file to ./supabase/functions/.env, fill in real values, then push.
# `.env` is gitignored.
# =============================================================================

# ---- Supabase auto-injected (do not set manually) ---------------------------
# SUPABASE_URL              - injected at runtime
# SUPABASE_ANON_KEY         - injected at runtime
# SUPABASE_SERVICE_ROLE_KEY - injected at runtime

# ---- Public site URL --------------------------------------------------------
# Used to build /i/<token> links in emails + SMS. No trailing slash.
PUBLIC_SITE_URL=https://getprettypotty.com

# ---- Resend (email) ---------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME
# Optional: Svix signing secret for the inbound-email webhook.
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---- Stripe (payments) ------------------------------------------------------
# Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# Dashboard → Developers → Webhooks → <your endpoint> → Signing secret
# Endpoint URL should be:
#   https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---- Quo / OpenPhone (SMS) --------------------------------------------------
# Quo (formerly OpenPhone) API key. Settings → API in the Quo dashboard.
# API access requires the Business plan.
QUO_API_KEY=op_REPLACE_ME
# Your Quo phone number in E.164 format (with leading + and country code).
QUO_FROM_NUMBER=+15125551234

# Legacy aliases — set EITHER the QUO_* OR the OPENPHONE_* variants, not both.
# OPENPHONE_API_KEY=
# OPENPHONE_FROM_NUMBER=

# ---- Cron shared secret -----------------------------------------------------
# Any random string. Required by invoice-reminders to authorize the daily
# cron POST. Use the same value in your cron job's Authorization header:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string
